# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# For the Discord Activity: the Discord application's client id, and where the site's Netlify
# functions are served (the sign-in token exchange). DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET
# go in the Netlify site's environment, not here.
VITE_DISCORD_CLIENT_ID=
VITE_FUNCTIONS_URL=https://your-site.netlify.app/.netlify/functions
