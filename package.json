{
  "name": "diff-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#rapier": {
      "node": "@dimforge/rapier3d-compat",
      "default": "@dimforge/rapier3d"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulator": "firebase emulators:start --only database --project demo-diff-race",
    "build": "tsc && vite build",
    "build:cars": "node scripts/build-cars.mjs",
    "build:props": "node scripts/build-props.mjs",
    "build:real": "node scripts/build-real.mjs",
    "build:textures": "node scripts/build-textures.mjs",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run",
    "check:arch": "node scripts/check-arch.mjs",
    "test:e2e": "firebase emulators:exec --only database --project demo-diff-race \"playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --only database --project demo-diff-race \"playwright test --ui\"",
    "check:tracks": "rolldown scripts/check-tracks.ts --platform node --format esm --file node_modules/.cache/check-tracks.mjs --log-level warn && node node_modules/.cache/check-tracks.mjs",
    "test:tracks": "npm run check:tracks -- --count 100 --golden",
    "sim:bots": "rolldown scripts/sim-bots.ts --platform node --format esm --file node_modules/.cache/sim-bots.mjs --no-codeSplitting --log-level warn && node node_modules/.cache/sim-bots.mjs",
    "test:rules": "firebase emulators:exec --only database --project demo-diff-race \"node scripts/test-rules.mjs\"",
    "deploy:rules": "firebase deploy --only database --non-interactive"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@discord/embedded-app-sdk": "^2.5.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "meshoptimizer": "^1.1.1",
    "pngjs": "^7.0.0",
    "rolldown": "~1.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3"
  }
}
